# VPS stack configuration. Copy to deploy/vps/.env (chmod 600) and fill in.
# Generate passwords with: openssl rand -hex 24

# ---------------------------------------------------------------- images
# Images published by .github/workflows/release.yml. IMAGE_TAG is a commit SHA or "latest".
REGISTRY=ghcr.io/guilyx
IMAGE_TAG=latest

# ---------------------------------------------------------------- web
# The public hostname (point an A/AAAA record at the server first; Caddy then gets a
# Let's Encrypt certificate on its own). Use DOMAIN=:80 to serve plain HTTP on the IP.
DOMAIN=loop.example.com
ACME_EMAIL=you@example.com

# ---------------------------------------------------------------- database
POSTGRES_PASSWORD=
DASHBOARD_DB_PASSWORD=
# Shared by the indexer and the dashboard for on-demand page refreshes
REVALIDATE_TOKEN=
# ~25% / ~75% of RAM is a good start (defaults suit a 2 GB box)
# PG_SHARED_BUFFERS=512MB
# PG_EFFECTIVE_CACHE_SIZE=1536MB

# ---------------------------------------------------------------- indexer
ETH_RPC_URLS=
BSC_RPC_URLS=
DUNE_API_KEY=
DUNE_NAMESPACE=
# Dead-man's switch (healthchecks.io, Better Stack, Cronitor...): pinged after every
# hourly cycle, <url>/fail when a step failed. Alert if no ping for ~2h.
INDEXER_HEARTBEAT_URL=

# ---------------------------------------------------------------- backups
# Daily at BACKUP_AT (UTC); restore drill on BACKUP_VERIFY_WEEKDAY (0 = Sunday, never = off).
BACKUP_AT=03:17
BACKUP_VERIFY_WEEKDAY=0
# age public key(s), space separated. Keep the private key OFF the server.
#   age-keygen -o loop-backup.key   ->   prints "Public key: age1..."
BACKUP_AGE_RECIPIENTS=
BACKUP_KEEP_DAILY_DAYS=14
BACKUP_KEEP_MONTHLY_DAYS=400
BACKUP_HEARTBEAT_URL=
BACKUP_VERIFY_HEARTBEAT_URL=

# Offsite copy to any S3-compatible bucket. Empty BACKUP_REMOTE = local volume only.
#   Backblaze B2:  OFFSITE_S3_ENDPOINT=https://s3.<region>.backblazeb2.com
#   Cloudflare R2: OFFSITE_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
#   AWS S3:        OFFSITE_S3_PROVIDER=AWS, OFFSITE_S3_REGION=<region>, no endpoint
# rclone path: offsite:<bucket>/<folder>, e.g. offsite:my-backups/loop
BACKUP_REMOTE=
OFFSITE_S3_PROVIDER=Other
OFFSITE_S3_ENDPOINT=
OFFSITE_S3_REGION=auto
OFFSITE_S3_ACCESS_KEY_ID=
OFFSITE_S3_SECRET_ACCESS_KEY=
