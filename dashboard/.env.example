# Optional. When set, the dashboard reads live data from Postgres (the loop.* views).
# Use a read-only login that inherits the `loop_reader` role. For Supabase, use the
# pooled connection string (transaction mode, port 6543).
# When unset, the dashboard serves the static snapshot in ./data (no database needed).
DATABASE_URL=

# Optional: shown on the /data page so readers can find the Dune tables.
NEXT_PUBLIC_DUNE_NAMESPACE=
