# ---------------------------------------------------------------- indexer
# Postgres (Supabase: use the direct or session-pooler connection string for the indexer)
DATABASE_URL=postgresql://loop:loop@localhost:5432/loop

# Archive RPC endpoints, comma-separated; the client fails over between them.
# Public endpoints work for small backfills but rate-limit heavily; use a provider key
# (Alchemy, QuickNode, dRPC, NodeReal...) for the hourly job.
ETH_RPC_URLS=https://eth-mainnet.public.blastapi.io,https://gateway.tenderly.co/public/mainnet
BSC_RPC_URLS=https://bsc-mainnet.public.blastapi.io

# Optional tuning
# RPC_TIMEOUT=30
# RPC_MAX_RETRIES=6
# RPC_MAX_BATCH_SIZE=20
# FINALITY_SECONDS=900
# LOG_FORMAT=auto   # auto | json | console
# LOG_LEVEL=INFO

# Optional: refresh the dashboard's cached pages right after each scheduled cycle
# (`loop-indexer schedule`), and a dead-man's-switch URL pinged after every cycle.
# DASHBOARD_REVALIDATE_URL=http://localhost:3000/api/revalidate
# REVALIDATE_TOKEN=          # same value in the dashboard's environment
# HEARTBEAT_URL=

# ---------------------------------------------------------------- Dune export
DUNE_API_KEY=
DUNE_NAMESPACE=
# DUNE_TABLE_PREFIX=loop

# ---------------------------------------------------------------- tests
# TEST_DATABASE_URL=postgresql://loop:loop@localhost:5432/loop_test
